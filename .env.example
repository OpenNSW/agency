# Root .env.example — copy to .env: `cp .env.example .env`
#
# THE single, self-contained env file for running the stack via docker compose.
# It is the ONLY env_file the containers load — backend/.env and frontend/.env
# are NOT read by compose (they exist only for bare-metal `go run` / `pnpm dev`).
#
# It serves two roles at once:
#
#   1. Compose interpolation — values for ${AGENCY_PORT}, ${DB_*} in compose.yaml.
#      `.env` is the name Compose auto-loads, so no flag is needed — just run:
#          docker compose up --build
#
#   2. Secrets — DB_PASSWORD and NSW_CLIENT_SECRET, which the server's
#      config.yaml (deployments/compose/config.yaml) resolves via
#      "{{env:NAME}}" placeholders.
#      Everything else the server reads (URLs, client ids, OU handle, scopes,
#      branding, ...) lives in that config.yaml directly, not here — compose
#      can't template a bind-mounted file per .env, so changing one of those
#      values means editing deployments/compose/config.yaml (see its own
#      comments for what has to be kept in sync, e.g. db.postgres.user/name
#      here vs DB_USER/DB_NAME below).
#
# The values below are DEV DEFAULTS for the NPQS agency against a local NSW-core
# IdP (https://localhost:8090); deployments/compose/config.yaml is pre-filled to
# match. Secrets are dev placeholders — do not use them in production.

# ===========================================================================
# Compose interpolation (host port mapping + postgres container init)
# ===========================================================================

# Postgres: initialises the db container (DB_USER/DB_PASSWORD/DB_NAME) and
# supplies DB_PASSWORD for the server's AND migrate's config.yaml
# "{{env:DB_PASSWORD}}" placeholder — their other connection settings come
# from the mounted deployments/compose/config.yaml, not these vars.
# DB_SSLMODE isn't read by anything in this compose stack; it's here for
# cmd/cli (see backend/.env.example), which still reads DB_* directly.
# If you change DB_USER/DB_NAME here, also update db.postgres.user/name in
# deployments/compose/config.yaml — that file can't read these vars.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nsw_agency_db
DB_SSLMODE=disable

# Agency server: the host-side port (the container always listens on 8081 —
# see compose.yaml's server.ports and deployments/compose/config.yaml).
AGENCY_PORT=8081

# ===========================================================================
# Secrets — resolved by the server's config.yaml via "{{env:NAME}}" placeholders
# ===========================================================================

# OAuth2 client secret for the Agency -> NSW m2m call.
NSW_CLIENT_SECRET=changeme
