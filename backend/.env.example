# Port the Agency server listens on
PORT=8081

# Maximum request body size (32 MiB)
# MAX_REQUEST_BYTES=33554432
# Maximum time to read request headers
# SERVER_READ_HEADER_TIMEOUT=5s
# Maximum time to read the full request
# SERVER_READ_TIMEOUT=15s
# Maximum time to write a response
# SERVER_WRITE_TIMEOUT=30s
# Maximum keep-alive idle time
# SERVER_IDLE_TIMEOUT=60s

# Database driver: sqlite | postgres
DB_DRIVER=sqlite

# SQLite settings (used if DB_DRIVER=sqlite). This path is relative to the working
# directory, which is read-only in the container — set it to /data there, the only
# writable path. Deployments use postgres, so this matters only for local runs.
DB_PATH=./agency_applications.db

# PostgreSQL settings (used if DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=nsw_agency_db
DB_SSLMODE=disable

# Path to SQL migration files directory
MIGRATION_DIR=./migrations

# ---------------------------------------------------------------------------
# Artifact loader — where task configs and form templates are loaded from.
# The manifest (manifest.json) and the artifacts it catalogs are fetched
# through the same loader, so both share one origin.
# ---------------------------------------------------------------------------

# Loader backend: local | github | s3. Only the selected backend's vars below
# are read.
ARTIFACT_LOADER_TYPE=local

# --- local (ARTIFACT_LOADER_TYPE=local) ---
# Directory that artifact paths (and manifest.json) are resolved against.
# Required — artifacts live outside this repo (e.g. a sibling checkout of the
# one-trade-artifacts repo). start-dev.sh sets this per agency automatically.
ARTIFACT_LOCAL_ROOT=

# --- github (ARTIFACT_LOADER_TYPE=github) ---
# Read artifacts from a GitHub repo at a pinned ref over the Contents API.
ARTIFACT_GITHUB_OWNER=
ARTIFACT_GITHUB_REPO=
# Branch, tag, or commit SHA — prefer an immutable tag/SHA.
ARTIFACT_GITHUB_REF=
# Optional in-repo directory prefix (empty = repo root).
ARTIFACT_GITHUB_BASE_PATH=
# Required for private repos; lifts the unauthenticated rate limit.
ARTIFACT_GITHUB_TOKEN=
# Optional REST API root, for GitHub Enterprise Server.
ARTIFACT_GITHUB_BASE_URL=
# Set true to fetch public repos via raw.githubusercontent.com (no token).
ARTIFACT_GITHUB_USE_RAW_HOST=false
ARTIFACT_GITHUB_RAW_BASE_URL=

# --- s3 (ARTIFACT_LOADER_TYPE=s3) ---
# Read artifacts from an S3 (or S3-compatible) bucket.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=
# Optional custom endpoint for S3-compatible stores (e.g. MinIO, LocalStack).
ARTIFACT_S3_ENDPOINT=
# Optional static credentials (must be set together; empty = default AWS chain).
ARTIFACT_S3_ACCESS_KEY=
ARTIFACT_S3_SECRET_KEY=
# Optional in-bucket key prefix (empty = bucket root).
ARTIFACT_S3_PREFIX=

# Comma-separated list of allowed CORS origins (use * to allow all)
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Officer-portal SPA (optional for bare-metal dev)
# ---------------------------------------------------------------------------
# The server serves the built portal and /runtime-env.js when WEB_DIR exists.
# For normal `go run` dev the frontend runs via its own Vite dev server and this
# dir is absent, so the server runs API-only and you can leave this section blank.
# It applies only to a local bundled-serving test build:
#   (cd frontend && pnpm build --outDir ../backend/web)
# in which case the VITE_* values below are served to the browser and the four
# marked REQUIRED are validated at startup.

# Directory the built SPA is served from, relative to the working dir.
WEB_DIR=web

# Branding config name -> /configs/${VITE_BRANDING_NAME}.branding.json
VITE_BRANDING_NAME=default
# Backend API base URL the browser calls (REQUIRED when serving the portal)
VITE_API_BASE_URL=http://localhost:8081
# Identity Provider (REQUIRED when serving the portal)
VITE_IDP_BASE_URL=https://localhost:8090
VITE_IDP_CLIENT_ID=<SPA_AGENCY_PORTAL>
# Portal app URL (used in OIDC redirects)
VITE_APP_URL=http://localhost:8081
# OAuth scopes requested at login (comma-separated). Only scopes requested here
# are granted, regardless of what the role permits — an agency:* scope the
# portal calls but doesn't request here is silently dropped from the issued
# token, and every route gated on it 403s. Keep this in sync with
# frontend/.env.example and deployments/helm/values-example.yaml, and add a
# new agency:* scope here only once the portal actually calls the route it
# gates.
VITE_IDP_SCOPES=openid,profile,email,ou,role,agency:application:read,agency:application:review,agency:application:feedback,agency:consignment:read,agency:storage:read,agency:storage:write
# Extra /authorize parameters. The `resource` value must equal AUTH_AUDIENCE, or the
# agency:* scopes are dropped from the issued token.
VITE_IDP_EXTRA_QUERY_PARAMS=resource=https://api.nsw-agency.local
# Agency OU handle the portal restricts access to (REQUIRED when serving the portal)
VITE_IDP_EXPECTED_OU_HANDLE=

# ---------------------------------------------------------------------------
# Inbound Auth — tokens the Agency backend accepts from the SPA / m2m clients
# ---------------------------------------------------------------------------

# JWKS endpoint of the IdP (used to verify incoming JWT signatures)
AUTH_JWKS_URL=https://localhost:8090/oauth2/jwks

# Expected issuer claim in incoming JWTs
AUTH_ISSUER=https://localhost:8090

# Expected audience claim in incoming JWTs.
# Each Agency has its own resource server registered in the IdP.
AUTH_AUDIENCE=https://api.nsw-agency.local

# Comma-separated list of allowed client_id values in incoming JWTs.
# Typically two clients: the SPA portal and the NSW->Agency m2m client.
# With start-dev.sh these are derived per agency, e.g. NPQS:
#   OGA_PORTAL_APP_NPQS,NSW_TO_NPQS
AUTH_CLIENT_IDS=<SPA_AGENCY_PORTAL>,NSW_TO_<AGENCY>

# The agency's OU handle — must match the ouHandle claim in user JWTs.
# Used to enforce that only users belonging to this agency can log in.
AUTH_EXPECTED_OU=

# DEV-ONLY: set to true to skip TLS verification for the JWKS endpoint.
# Keep false in production. Only honored when APP_ENV=development (set by
# compose/start-dev); otherwise the backend refuses to start on this flag.
AUTH_JWKS_INSECURE_SKIP_VERIFY=true

# ---------------------------------------------------------------------------
# Outbound Auth — credentials used by the Agency backend to call the NSW API
# ---------------------------------------------------------------------------

# Base URL of the NSW API
NSW_API_BASE_URL=http://localhost:8080

# OAuth2 client credentials for the Agency -> NSW m2m call.
# Must correspond to a client registered in the IdP with access to the NSW API.
NSW_CLIENT_ID=<M2M_AGENCY_TO_NSW>
NSW_CLIENT_SECRET=changeme
NSW_TOKEN_URL=https://localhost:8090/oauth2/token
# Extra token-request parameters, query-string encoded and sent in the body (RFC 6749
# 3.2). NSW's IdP requires an RFC 8707 `resource` indicator; another may want `audience`
# or none. Separate several with `&` and quote the value when exporting from a shell.
NSW_TOKEN_PARAMS=resource=https://api.nsw-srilanka.local

# Comma-separated scopes requested when obtaining NSW API tokens.
# Must match the scopes granted to the M2M client's role in the IdP
# (AgencyM2M role -> NSW_API resource server).
NSW_SCOPES=nsw:task:write,nsw:consignment:read,nsw:storage:read,nsw:storage:write

# DEV-ONLY: set to true to skip TLS verification for the NSW token endpoint.
# Keep false in production. Only honored when APP_ENV=development (set by
# compose/start-dev); otherwise the backend refuses to start on this flag.
NSW_TOKEN_INSECURE_SKIP_VERIFY=true
