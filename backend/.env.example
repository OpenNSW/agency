# Most of the Agency server's configuration now lives in config.yaml — copy
# backend/config.example.yaml to backend/config.yaml and edit it (uncomment
# `environment: development` there if you're running against a self-signed
# local IdP — see that file's own comments). cmd/migrate reads the SAME
# config.yaml file (its db + migrationDir fields), so this file only covers
# what genuinely has to be an env var:
#
#   - CONFIG_PATH: needed by cmd/server AND cmd/migrate to find config.yaml
#     in the first place, so it can't live inside it.
#   - Whatever env vars config.yaml's "{{env:NAME}}" placeholders reference
#     (see backend/config.example.yaml) — by default that's DB_PASSWORD,
#     NSW_CLIENT_SECRET, and (only if you switch the artifact loader to
#     github/s3) ARTIFACT_GITHUB_TOKEN / ARTIFACT_S3_SECRET_KEY, but any
#     field can use this, not just these.
#   - Everything cmd/cli reads (DB_*, USER_CUSTOM_DATA_SCHEMA_PATH) — that
#     command is unchanged and still reads plain env vars, independent of
#     config.yaml.

# Path to cmd/server's AND cmd/migrate's config file (defaults to
# ./config.yaml if unset).
CONFIG_PATH=./config.yaml

# ---------------------------------------------------------------------------
# Database — read by cmd/server and cmd/migrate (via config.yaml's
# db.postgres.password "{{env:DB_PASSWORD}}" placeholder), and directly by
# cmd/cli, which still has its own separate DB_* env vars below (cmd/cli was
# not part of this migration).
# ---------------------------------------------------------------------------

# Database driver: sqlite | postgres. Only read by cmd/cli — cmd/server's and
# cmd/migrate's driver choice is config.yaml's db.driver.
DB_DRIVER=sqlite

# SQLite settings (used if DB_DRIVER=sqlite). This path is relative to the working
# directory, which is read-only in the container — set it to /data there, the only
# writable path. Deployments use postgres, so this matters only for local runs.
# Commented out rather than set to a fixed default: start-dev.sh derives its
# own per-agency default from that agency's config/<agency>/config.yaml
# db.sqlite.path (see sqlite_path_from_config) — setting DB_PATH here would
# override that derivation for every agency. cmd/cli defaults to
# ./agency_applications.db on its own when this is unset.
# DB_PATH=./agency_applications.db

# PostgreSQL settings (used if DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=nsw_agency_db
DB_SSLMODE=disable

# Optional: path to a JSON Schema file validating the "customData" field on
# `nswac user add` seed entries (agency-specific employee data, stored in
# users.custom_data). Unset skips validation entirely — only read by the
# nswac CLI, not the server. start-dev.sh derives this per agency
# automatically (config/<agency>/user-custom-data-schema.json, when present).
# USER_CUSTOM_DATA_SCHEMA_PATH=./config/npqs/user-custom-data-schema.json

# ---------------------------------------------------------------------------
# Secrets cmd/server's config.yaml resolves via "{{env:NAME}}" placeholders
# (see backend/config.example.yaml). Only set the ones your config.yaml
# actually references.
# ---------------------------------------------------------------------------

# OAuth2 client secret for the Agency -> NSW m2m call (config.yaml:
# nsw.clientSecret).
NSW_CLIENT_SECRET=changeme

# Only needed if config.yaml's artifactLoader.type is github/s3 and its
# token/secretKey field references these.
# ARTIFACT_GITHUB_TOKEN=
# ARTIFACT_S3_SECRET_KEY=
