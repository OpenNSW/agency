# Go binaries. Anchored to the module root: an unanchored "server" also matches
# the cmd/server directory, which silently drops new source files from commits.
/server
**/server/server
*.exe
*.dll
*.so
*.dylib

# Go test binaries
*.test

# Go coverage files
*.out

# Dependency directories
vendor/

# Environment files
.env
.env.local

# Per-developer server config (copy config.example.yaml here and edit).
# Anchored to the module root: unanchored would also match the checked-in
# per-agency configs at config/<agency>/config.yaml (see start-dev.sh).
/config.yaml

# Per-deployment data is local-only. Only the default examples ship in the repo;
# agencies provide their own task configs and forms via CONFIG_DIR.
# TODO: for now, we check-in all the templates, need to clean this up.
# data/*
# !data/forms/
# data/forms/*
# !data/forms/default_review.json
# !data/task-configs/
# data/task-configs/*
# !data/task-configs/default.json

# OS-specific files
.DS_Store
Thumbs.db