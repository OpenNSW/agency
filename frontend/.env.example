# Frontend dev-server-only config. The frontend no longer reads app runtime
# config (branding, IdP settings, etc.) from env vars/import.meta.env at all —
# it reads window.__APP_CONFIG__ from /config.js, which the backend serves
# from its own config.yaml (web.runtime) in both dev and prod. See
# frontend/src/runtimeConfig.ts and backend/config.example.yaml.
#
# These two vars are the only ones still read here, and only by
# vite.config.ts (Node-side, never bundled into the app):

# The dev server's own port.
VITE_PORT=5173

# Which backend this dev server proxies /config.js to (see vite.config.ts).
# Point this at whichever agency backend you're running against, e.g.
# http://localhost:8081 for npqs — see start-dev.sh's CONFIG_* table for the
# full port mapping, and backend/config/<agency>/config.yaml for that
# backend's actual runtime values (branding, IdP client id, expected OU, ...).
VITE_API_BASE_URL=http://localhost:8081
